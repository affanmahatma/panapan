body {
    background-color: #FFFFEO; /* warna kuning cerah */
    font-family: Arial, sans-serif, /* jjenis huruf yang bersiih dan muudah dibaca */
      color: #191970; /* warna teks utama (biru gelap) */
}

kartu profil (
  width: 300px;
  margin: 50px auto; /* 50px jarak atas/bawah, auto menengahkan kiri/
  padding: 20px;
  backround-color: white;
  border-radius: 15px /*  membuat sudut menjadi melenglung */
  box-shadow: 0 4px 8px rgba (0,0,0,0,1); /* efek bayangan */
  }


kartu profil img (
  width: 150px
  border-radius: 50px /* trik untuk membuat gambar persegi menjadi lingkaran sempurna */
}
kartu profil {
  /* _ _ _ (kode dari slide sebelumnya) - - - */
  text-align: center; /* menengahkan semua teks di dalam kartu */
}
